{
  "name": "ody-refine",
  "version": "0.1.0",
  "description": "Find contradictions, staleness, and drift in your documentation — locally, in seconds",
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "ody-refine": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/postbuild.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "prepublish-check": "bash scripts/prepublish-check.sh"
  },
  "dependencies": {
    "@toml-tools/parser": "^1.0.0",
    "@useody/detectors": "0.0.2",
    "@useody/export": "0.0.2",
    "@useody/feedback": "0.0.2",
    "@useody/platform-core": "0.0.1",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "open": "^10.1.0",
    "ora": "^8.2.0"
  },
  "optionalDependencies": {
    "@mendable/firecrawl-js": "^1.15.0",
    "ink": "^5.1.0",
    "ink-select-input": "^6.0.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@notionhq/client": "^5.13.0",
    "@types/pdf-parse": "^1.1.0",
    "@types/react": "^19.2.14",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ufukkaraca/ody-refine.git",
    "directory": "apps/refine"
  },
  "homepage": "https://github.com/ufukkaraca/ody-refine#readme",
  "bugs": {
    "url": "https://github.com/ufukkaraca/ody-refine/issues"
  },
  "keywords": [
    "documentation",
    "knowledge",
    "contradictions",
    "staleness",
    "lint",
    "cli",
    "integrity",
    "audit",
    "quality",
    "ai"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ]
}
