{
  "name": "ody-refine",
  "version": "0.1.0",
  "description": "Find contradictions, staleness, and drift in your documentation — locally, in seconds",
  "type": "module",
  "bin": {
    "ody-refine": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@useody/detectors": "workspace:*",
    "@useody/export": "workspace:*",
    "@useody/platform-core": "workspace:*",
    "@toml-tools/parser": "^1.0.0",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "ink": "^5.1.0",
    "ink-select-input": "^6.0.0",
    "open": "^10.1.0",
    "ora": "^8.2.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.0",
    "@types/react": "^19.2.14",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": { "access": "public" },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ufukkaraca/ody-platform.git",
    "directory": "apps/refine"
  },
  "homepage": "https://github.com/ufukkaraca/ody-platform#readme",
  "keywords": [
    "documentation",
    "knowledge",
    "contradictions",
    "staleness",
    "lint",
    "cli",
    "integrity",
    "audit",
    "quality"
