#!/usr/bin/env sh

# --- Secret scanning ---
# Block commits containing API keys, secrets, or local paths
SECRETS_PATTERN='sk-or-v1|sk-ant-|sk-proj-|xoxb-|xoxp-|secret_'
ENV_FILES=$(git diff --cached --name-only | grep -E '\.env($|\.)' || true)

if [ -n "$ENV_FILES" ]; then
  echo "❌ Blocked: .env files must not be committed:"
  echo "$ENV_FILES"
  exit 1
fi

# Check staged file contents for secrets (skip tests, docs, hooks, contributing)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED_FILES" ]; then
  CHECK_FILES=$(echo "$STAGED_FILES" | grep -vE '__tests__/|\.test\.|\.spec\.|CONTRIBUTING|INTEGRATION_TESTING|\.husky/' || true)
  if [ -n "$CHECK_FILES" ]; then
    # Match real secrets (with sufficient length), not test stubs like 'sk-ant-test-key' or 'xoxb-test'
    MATCHES=$(echo "$CHECK_FILES" | xargs grep -lE 'sk-or-v1-[a-f0-9]{20,}|sk-ant-api[a-zA-Z0-9_-]{20,}|sk-proj-[a-zA-Z0-9_-]{20,}|xoxb-[0-9]{10,}|xoxp-[0-9]{10,}' 2>/dev/null || true)
    if [ -n "$MATCHES" ]; then
      echo "❌ Blocked: possible secrets detected in:"
      echo "$MATCHES"
      echo ""
      echo "Patterns checked: real API keys with sufficient length"
      echo "If this is a false positive, use git commit --no-verify (with caution)."
      exit 1
    fi
  fi

  # Only check source code files for local paths (skip docs, hooks, configs)
  CODE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx|json|yml|yaml)$' || true)
  if [ -n "$CODE_FILES" ]; then
    PATH_MATCHES=$(echo "$CODE_FILES" | xargs grep -lE '/Users/' 2>/dev/null || true)
    if [ -n "$PATH_MATCHES" ]; then
      echo "❌ Blocked: local machine paths (/Users/) detected in:"
      echo "$PATH_MATCHES"
      echo ""
      echo "Replace with relative paths or environment variables."
      exit 1
    fi
  fi
fi

# --- Lint staged files ---
npx lint-staged

# --- Typecheck ---
pnpm typecheck
