{
  "name": "@useody/platform-core",
  "description": "Knowledge graph types, SQLite storage, vector search, and provider interfaces for Ody Platform",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "sqlite-vec": "^0.1.6"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "vitest": "^3.0.0",
    "typescript": "^5.7.0"
  },
  "engines": { "node": ">=20.0.0" },
  "publishConfig": { "access": "public" },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ufukkaraca/ody-platform.git",
    "directory": "packages/core"
  },
  "files": ["dist", "README.md", "LICENSE"]
}
