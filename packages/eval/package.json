    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@useody/platform-core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.0",
    "typescript": "^5.7.0"
  },
  "engines": { "node": ">=20.0.0" },
  "publishConfig": { "access": "public" },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ufukkaraca/ody-refine.git",
